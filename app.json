{
  "expo": {
    "name": "mooscles",
    "slug": "mooscles",
    "owner": "selyanykms-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3eebfc25-59a2-45dd-9dc5-a9e84b573fd9"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00296B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.selyanykm.mooscles",
      "permissions": ["android.permission.POST_NOTIFICATIONS", "android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 200, "backgroundColor": "#00296B" }],
      "expo-audio",
      "expo-notifications",
      "expo-file-system"
    ],
    "extra": {
      "eas": {
        "projectId": "3eebfc25-59a2-45dd-9dc5-a9e84b573fd9"
      }
    }
  }
}
